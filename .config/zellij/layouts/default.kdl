// VS Code "Dark Modern" — zjstatus does not read zellij's theme, so its palette
// is hardcoded here and must be kept in sync with the `themes` block in
// ~/.config/zellij/config.kdl, ~/.config/kitty/theme.conf and
// ~/.config/nvim/init.lua.
//
//   bar bg  #181818 (VS Code status bar / tab bar chrome)
//   muted   #9D9D9D (inactive tab foreground)
//   accent  #0078D4 (VS Code status bar blue)
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}#[bg=#181818] {tabs}"
                format_right  "#[fg=#9D9D9D,bg=#181818]{session} #[fg=#3B8EEA,bg=#181818]{datetime}"
                format_space  "#[bg=#181818]"

                border_enabled  "false"
                mode_normal       "#[bg=#0078D4,fg=#FFFFFF,bold] NORMAL "
                mode_locked       "#[bg=#666666,fg=#FFFFFF,bold] LOCKED "
                mode_tmux         "#[bg=#E5E510,fg=#181818,bold] TMUX "
                mode_pane         "#[bg=#23D18B,fg=#181818,bold] PANE "
                mode_tab          "#[bg=#23D18B,fg=#181818,bold] TAB "
                mode_resize       "#[bg=#CE9178,fg=#181818,bold] RESIZE "
                mode_move         "#[bg=#CE9178,fg=#181818,bold] MOVE "
                mode_scroll       "#[bg=#29B8DB,fg=#181818,bold] SCROLL "
                mode_enter_search "#[bg=#29B8DB,fg=#181818,bold] SEARCH: "
                mode_search       "#[bg=#29B8DB,fg=#181818,bold] SEARCH "
                mode_rename_tab   "#[bg=#D670D6,fg=#181818,bold] RENAME TAB "
                mode_rename_pane  "#[bg=#D670D6,fg=#181818,bold] RENAME PANE "
                mode_session      "#[bg=#D670D6,fg=#181818,bold] SESSION "
                mode_prompt       "#[bg=#F14C4C,fg=#FFFFFF,bold] PROMPT "
                mode_default_to_mode "normal"

                tab_normal   "#[fg=#9D9D9D,bg=#181818] {index} {name} "
                tab_active   "#[fg=#FFFFFF,bg=#0078D4,bold] [{index}] {name} "
                tab_rename   "#[fg=#181818,bg=#E5E510,bold] [{index}] {name} "
                tab_separator "#[bg=#181818] "

                datetime        "#[fg=#9D9D9D,bg=#181818] {format} "
                datetime_format "%H:%M"
                datetime_timezone "Europe/Amsterdam"
            }
        }
    }
}
